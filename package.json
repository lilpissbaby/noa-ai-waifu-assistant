{
  "name": "waifu-desk",
  "productName": "Waifu Desk",
  "desktopName": "waifu-desk.desktop",
  "version": "0.2.0",
  "description": "AI assistant with a floating anime avatar on your desktop (Claude, OpenAI-compatible, Hermes, Paperclip, MCP)",
  "homepage": "https://github.com/lilpissbaby/noa-ai-waifu-assistant",
  "repository": {
    "type": "git",
    "url": "https://github.com/lilpissbaby/noa-ai-waifu-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/lilpissbaby/noa-ai-waifu-assistant/issues"
  },
  "main": "src/main/main.js",
  "type": "module",
  "author": "mupsim",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --import ./test/setup.mjs --test \"test/*.test.mjs\"",
    "lint": "eslint .",
    "smoke": "node tools/smoke.mjs",
    "screenshots": "node tools/smoke.mjs tools/automation/screenshots.mjs --scale=2",
    "dist:win": "electron-builder --win dir zip --publish never && node build/make-installer.mjs",
    "dist:linux": "electron-builder --linux --publish never",
    "skin:default": "python3 tools/draw_default_skin.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "onnxruntime-web": "^1.30.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "desk.waifu.app",
    "productName": "Waifu Desk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/onnxruntime-web/lib/**",
      "!node_modules/onnxruntime-web/dist/**",
      "node_modules/onnxruntime-web/dist/ort.wasm.min.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm",
      "!node_modules/three/**",
      "!node_modules/@pixiv/**",
      "node_modules/three/build/three.module.js",
      "node_modules/three/build/three.core.js",
      "node_modules/@pixiv/three-vrm/lib/three-vrm.module.min.js",
      "node_modules/@pixiv/three-vrm-animation/lib/three-vrm-animation.module.min.js",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "loaders/GLTFLoader.js",
          "loaders/FBXLoader.js",
          "utils/BufferGeometryUtils.js",
          "utils/SkeletonUtils.js",
          "libs/fflate.module.js",
          "curves/NURBSCurve.js",
          "curves/NURBSUtils.js"
        ]
      }
    ],
    "afterPack": "build/after-pack.mjs",
    "win": {
      "target": [
        "dir",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "WaifuDesk-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "mupsim",
      "artifactName": "WaifuDesk-${version}-linux-${arch}.${ext}",
      "synopsis": "AI assistant with a floating anime avatar",
      "syncDesktopName": true
    },
    "publish": null
  }
}
